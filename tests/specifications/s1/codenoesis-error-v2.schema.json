{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codenoesis:schema:error:v2",
  "title": "CodeNoesisErrorV2 S1 subset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "stage", "message", "retryable", "context"],
  "properties": {
    "schema_version": {
      "const": "codenoesis.error/v2"
    },
    "code": {
      "enum": [
        "input.invalid_repository_identity",
        "input.invalid_revision",
        "input.invalid_profile",
        "acquisition.not_git_repository",
        "acquisition.revision_not_found",
        "acquisition.revision_not_commit",
        "acquisition.object_missing",
        "acquisition.repository_inconsistent",
        "acquisition.unsupported_repository_shape",
        "acquisition.path_invalid",
        "acquisition.root_policy_violation",
        "acquisition.entry_policy_violation",
        "acquisition.limit_exceeded",
        "internal.unexpected"
      ]
    },
    "stage": {
      "enum": ["input", "acquisition", "internal"]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n]+$"
    },
    "retryable": {
      "const": false
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|refs/heads/main)$"
        },
        "object_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expected_kind": {
          "enum": ["commit", "tree", "blob"]
        },
        "actual_kind": {
          "enum": ["tag", "tree", "blob"]
        },
        "referenced_by": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "feature": {
          "enum": [
            "bare_repository",
            "shallow_repository",
            "sha256_object_format",
            "alternate_object_database",
            "replace_or_graft",
            "lfs_materialization",
            "packed_object_database"
          ]
        },
        "reason": {
          "enum": [
            "non_utf8",
            "empty_component",
            "dot_component",
            "backslash",
            "control_character"
          ]
        },
        "policy": {
          "enum": [
            "repository_root_is_symlink",
            "git_directory_not_contained",
            "git_directory_is_symlink"
          ]
        },
        "entry": {
          "enum": ["symlink", "gitlink", "special_file_mode"]
        },
        "path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "limit": {
          "enum": [
            "regular_files",
            "tree_entries",
            "cumulative_file_bytes",
            "single_file_bytes",
            "path_bytes",
            "path_component_bytes",
            "recursion_depth",
            "canonical_output_bytes",
            "scan_wall_milliseconds"
          ]
        },
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "observed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435457
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "input.invalid_repository_identity",
              "input.invalid_revision",
              "input.invalid_profile"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "input"
          },
          "context": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.not_git_repository"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.revision_not_found"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["revision"],
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.revision_not_commit"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["object_oid", "actual_kind"],
            "maxProperties": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.object_missing"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["object_oid", "expected_kind", "referenced_by"],
            "maxProperties": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.repository_inconsistent"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["object_oid", "expected_kind"],
            "maxProperties": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.unsupported_repository_shape"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["feature"],
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.path_invalid"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["reason"],
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.root_policy_violation"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["policy"],
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.entry_policy_violation"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["entry", "path"],
            "maxProperties": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.limit_exceeded"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": ["limit", "maximum", "observed"],
            "maxProperties": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "internal.unexpected"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "internal"
          },
          "context": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "canonical_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*$"
    }
  }
}
