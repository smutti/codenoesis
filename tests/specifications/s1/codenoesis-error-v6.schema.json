  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.object_database_changed"
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "retryable": {
            "const": false
          }
