{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codenoesis:schema:error:v6",
  "title": "CodeNoesisErrorV6 packed SHA-1 acquisition subset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "stage",
    "message",
    "retryable",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.error/v6"
    },
    "code": {
      "enum": [
        "input.invalid_repository_identity",
        "input.invalid_revision",
        "input.invalid_profile",
        "input.invalid_acquisition_profile",
        "acquisition.not_git_repository",
        "acquisition.revision_not_found",
        "acquisition.revision_not_commit",
        "acquisition.object_missing",
        "acquisition.repository_inconsistent",
        "acquisition.unsupported_repository_shape",
        "acquisition.path_invalid",
        "acquisition.root_policy_violation",
        "acquisition.entry_policy_violation",
        "acquisition.limit_exceeded",
        "acquisition.object_database_invalid",
        "acquisition.object_database_changed",
        "acquisition.object_database_unavailable",
        "internal.unexpected"
      ]
    },
    "stage": {
      "enum": [
        "input",
        "acquisition",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n]+$"
    },
    "retryable": {
      "type": "boolean"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|refs/heads/main)$"
        },
        "object_oid": {
          "$ref": "#/$defs/oid"
        },
        "expected_kind": {
          "enum": [
            "commit",
            "tree",
            "blob"
          ]
        },
        "actual_kind": {
          "enum": [
            "tag",
            "tree",
            "blob"
          ]
        },
        "referenced_by": {
          "$ref": "#/$defs/oid"
        },
        "feature": {
          "enum": [
            "bare_repository",
            "shallow_repository",
            "sha256_object_format",
            "alternate_object_database",
            "replace_or_graft",
            "lfs_materialization",
            "packed_object_database",
            "pack_version_unsupported",
            "pack_index_version_unsupported",
            "promisor_object_database",
            "multi_pack_index_only"
          ]
        },
        "reason": {
          "enum": [
            "non_utf8",
            "empty_component",
            "dot_component",
            "backslash",
            "control_character",
            "catalog_entry",
            "index_layout",
            "index_fanout",
            "index_object_order",
            "index_offset",
            "index_checksum",
            "pack_header",
            "pack_checksum",
            "pack_index_mismatch",
            "object_count",
            "entry_header",
            "entry_crc",
            "zlib_stream",
            "object_size",
            "object_oid",
            "sha1_collision",
            "delta_base",
            "delta_cycle",
            "delta_program",
            "duplicate_object_conflict"
          ]
        },
        "policy": {
          "enum": [
            "repository_root_is_symlink",
            "git_directory_not_contained",
            "git_directory_is_symlink"
          ]
        },
        "entry": {
          "enum": [
            "symlink",
            "gitlink",
            "special_file_mode"
          ]
        },
        "path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "limit": {
          "enum": [
            "regular_files",
            "tree_entries",
            "cumulative_file_bytes",
            "single_file_bytes",
            "path_bytes",
            "path_component_bytes",
            "recursion_depth",
            "canonical_output_bytes",
            "scan_wall_milliseconds",
            "pack_directory_entries",
            "pack_pairs",
            "single_pack_index_bytes",
            "cumulative_pack_index_bytes",
            "indexed_objects",
            "single_pack_bytes",
            "cumulative_verified_pack_bytes",
            "compressed_entry_bytes",
            "inflated_entry_bytes",
            "cumulative_entry_inflate_bytes",
            "delta_program_bytes",
            "delta_depth",
            "delta_instructions",
            "delta_intermediate_bytes",
            "cumulative_delta_work_bytes",
            "object_locations",
            "reconstructed_object_cache_bytes"
