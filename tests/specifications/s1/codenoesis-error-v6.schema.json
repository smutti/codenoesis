          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "observed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934593
        },
        "component": {
          "enum": [
            "catalog",
            "index",
            "pack",
            "entry",
            "delta",
            "object"
