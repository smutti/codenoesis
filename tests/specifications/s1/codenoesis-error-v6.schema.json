            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "reason": {
                "enum": [
                  "non_utf8",
                  "empty_component",
                  "dot_component",
                  "backslash",
                  "control_character"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.root_policy_violation"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": [
              "policy"
            ],
            "minProperties": 1,
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.entry_policy_violation"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": [
              "entry",
              "path"
            ],
            "minProperties": 2,
            "maxProperties": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.limit_exceeded"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "$ref": "#/$defs/limit_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "acquisition.object_database_invalid"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "$ref": "#/$defs/object_database_invalid_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "acquisition.object_database_changed",
              "acquisition.object_database_unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "acquisition"
          },
          "context": {
            "required": [
              "component"
            ],
            "minProperties": 1,
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "internal.unexpected"
          }
        }
      },
      "then": {
        "properties": {
          "stage": {
            "const": "internal"
          },
          "context": {
            "maxProperties": 0
          }
        }
      }
    }
