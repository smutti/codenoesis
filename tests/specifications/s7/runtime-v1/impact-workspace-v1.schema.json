{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/impact-workspace-v1.schema.json",
  "title": "ImpactWorkspaceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_profile",
    "pipeline",
    "contract_capability",
    "provider_capability",
    "client_capability",
    "provider",
    "clients",
    "federation_report"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.impact-workspace/v1"
    },
    "analysis_profile": {
      "const": "implementation-aware-http-json/v1"
    },
    "pipeline": {
      "const": "codenoesis.pipeline/s7-v1"
    },
    "contract_capability": {
      "const": "codenoesis.contract-capability/openapi-3.1-http-json/v1"
    },
    "provider_capability": {
      "const": "rust-direct-json-map/v1"
    },
    "client_capability": {
      "const": "kotlin-direct-json-access/v1"
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/client"
      }
    },
    "federation_report": {
      "$ref": "#/$defs/bound_file"
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^urn:codenoesis:[a-z0-9][a-z0-9:._/-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "safe_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000\\r\\n]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "bound_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safe_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "revision_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "root",
        "contract",
        "source",
        "callable_symbol"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "root": {
          "$ref": "#/$defs/safe_path"
        },
        "contract": {
          "$ref": "#/$defs/bound_file"
        },
        "source": {
          "$ref": "#/$defs/bound_file"
        },
        "callable_symbol": {
          "$ref": "#/$defs/symbol"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_identity",
        "baseline",
        "target"
      ],
      "properties": {
        "repository_identity": {
          "$ref": "#/$defs/identity"
        },
        "baseline": {
          "$ref": "#/$defs/revision_input"
        },
        "target": {
          "$ref": "#/$defs/revision_input"
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "repository_identity",
        "revision",
        "root",
        "source",
        "decoder_symbol",
        "call_symbol"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "decoy",
            "safe",
            "strict"
          ]
        },
        "repository_identity": {
          "$ref": "#/$defs/identity"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "root": {
          "$ref": "#/$defs/safe_path"
        },
        "source": {
          "$ref": "#/$defs/bound_file"
        },
        "decoder_symbol": {
          "$ref": "#/$defs/symbol"
        },
        "call_symbol": {
          "$ref": "#/$defs/symbol"
        }
      }
    }
  }
}
