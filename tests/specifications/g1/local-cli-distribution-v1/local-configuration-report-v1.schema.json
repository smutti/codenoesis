{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/local-configuration-report-v1.schema.json",
  "title": "LocalConfigurationReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configuration_schema",
    "source",
    "release_profile",
    "semantic_hash",
    "configuration"
  ],
  "properties": {
    "schema_version": { "const": "codenoesis.configuration-report/v1" },
    "configuration_schema": { "const": "codenoesis.configuration/local-cli/v1" },
    "source": { "enum": ["embedded-default", "explicit-file"] },
    "release_profile": { "const": "local-experimental-r17" },
    "semantic_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "blake3-256" },
        "value": {
          "const": "62bbfd0abce84b8eab9d970fc48d3c426925e41b2f583f09d5d7215c24f30b00"
        }
      }
    },
    "configuration": { "$ref": "local-cli-config-v1.schema.json" }
  }
}
