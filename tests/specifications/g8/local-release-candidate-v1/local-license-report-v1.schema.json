{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/local-license-report-v1.schema.json",
  "title": "LocalLicenseReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "cargo_lock_sha256",
    "policy",
    "status",
    "packages",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.local-license-report/v1"
    },
    "target": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "cargo_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy": {
      "const": "codenoesis.local-release-policy/v1"
    },
    "status": {
      "const": "accepted"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "#license-package",
        "title": "LicensePackageV1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expression",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "expression": {
            "type": "string",
            "maxLength": 256
          },
          "decision": {
            "const": "allowed"
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 0
    }
  }
}
