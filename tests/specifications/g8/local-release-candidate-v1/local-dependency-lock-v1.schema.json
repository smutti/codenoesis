{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/local-dependency-lock-v1.schema.json",
  "title": "LocalDependencyLockV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "root",
    "cargo_lock_sha256",
    "packages",
    "dependency_edges"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.local-dependency-lock/v1"
    },
    "target": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "root": {
      "const": "noesis@0.1.0"
    },
    "cargo_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "#package",
        "title": "LockedPackageV1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "source",
          "checksum",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "maxLength": 256
          },
          "checksum": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dependencies": {
            "type": "array",
            "maxItems": 512,
            "items": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      }
    },
    "dependency_edges": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    }
  }
}
