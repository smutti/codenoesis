{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/local-unsafe-inventory-v1.schema.json",
  "title": "LocalUnsafeInventoryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "cargo_lock_sha256",
    "method",
    "status",
    "packages",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.local-unsafe-inventory/v1"
    },
    "target": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "cargo_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "const": "conservative-rust-token-scan-v1"
    },
    "status": {
      "const": "accepted"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "#unsafe-package",
        "title": "UnsafePackageV1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rust_files",
          "unsafe_tokens",
          "exception_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "rust_files": {
            "type": "integer",
            "minimum": 0
          },
          "unsafe_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "exception_id": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "#unsafe-exception",
        "title": "UnsafeExceptionV1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "version",
          "owner",
          "expires_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "package": {
            "type": "string",
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "maxLength": 128
          },
          "owner": {
            "const": "@smutti"
          },
          "expires_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
