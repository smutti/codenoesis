{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codenoesis:schema:source-evidence:v2",
  "title": "SourceEvidenceV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "repository",
    "blob_oid",
    "path",
    "span",
    "extractor",
    "syntax_kind",
    "derivation"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.source-evidence/v2"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-s2-[0-9]{4}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "object_format", "commit_oid"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/repository_identity"
        },
        "object_format": {
          "const": "sha1"
        },
        "commit_oid": {
          "$ref": "#/$defs/git_sha1"
        }
      }
    },
    "blob_oid": {
      "$ref": "#/$defs/git_sha1"
    },
    "path": {
      "$ref": "#/$defs/canonical_relative_path"
    },
    "span": {
      "$ref": "#/$defs/byte_span"
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "const": "codenoesis.rust-tree-sitter"
        },
        "version": {
          "const": "codenoesis.rust-tree-sitter/s2-v1"
        }
      }
    },
    "syntax_kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "derivation": {
      "const": "tree_sitter_concrete_syntax"
    }
  },
  "$defs": {
    "repository_identity": {
      "type": "string",
      "pattern": "^urn:codenoesis:[a-z0-9][a-z0-9._:-]{0,254}$"
    },
    "canonical_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*$"
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "byte_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "start", "end"],
      "properties": {
        "unit": {
          "const": "byte"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    }
  }
}
