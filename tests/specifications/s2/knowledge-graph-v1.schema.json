{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codenoesis:schema:knowledge-graph:v1",
  "title": "KnowledgeGraphV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_version",
    "repository",
    "extractor_versions",
    "semantic_hash",
    "entities",
    "relationships",
    "claims",
    "evidence",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.knowledge-graph/v1"
    },
    "ontology_version": {
      "const": "codenoesis.ontology/rust/v1"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "extractor_versions": {
      "const": ["codenoesis.rust-tree-sitter/s2-v1"]
    },
    "semantic_hash": {
      "$ref": "#/$defs/semantic_hash"
    },
    "entities": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 300000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 400000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 400000,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:codenoesis:schema:source-evidence:v2"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 20000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "object_format", "commit_oid"],
      "properties": {
        "identity": {
          "$ref": "#/$defs/repository_identity"
        },
        "object_format": {
          "const": "sha1"
        },
        "commit_oid": {
          "$ref": "#/$defs/git_sha1"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "kind",
        "canonical_identity",
        "display_name",
        "language",
        "properties",
        "evidence_ids",
        "claim_id"
      ],
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "kind": {
          "$ref": "#/$defs/entity_kind"
        },
        "canonical_identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "language": {
          "const": "rust"
        },
        "properties": {
          "$ref": "#/$defs/entity_properties"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rust.crate"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": ["crate_root"],
                "minProperties": 1,
                "maxProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source.file"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": ["path"],
                "minProperties": 1,
                "maxProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "rust.enum",
                  "rust.function",
                  "rust.module",
                  "rust.struct",
                  "rust.trait",
                  "rust.type_alias"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": ["visibility"],
                "minProperties": 1,
                "maxProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rust.method"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": ["owner_kind", "visibility"],
                "minProperties": 2,
                "maxProperties": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "rust.symbol_reference"
              }
            }
          },
          "then": {
            "properties": {
              "properties": {
                "required": ["resolution", "symbol_path"],
                "minProperties": 2,
                "maxProperties": 2
              }
            }
          }
        }
      ]
    },
    "entity_properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "crate_root": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "visibility": {
          "enum": ["inherited_trait", "private", "public"]
        },
        "owner_kind": {
          "enum": ["rust.enum", "rust.struct", "rust.trait"]
        },
        "resolution": {
          "const": "unresolved"
        },
        "symbol_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\r\\n\\u0000]+$"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "kind",
        "source_entity_id",
        "target_entity_id",
        "evidence_ids",
        "claim_id"
      ],
      "properties": {
        "relationship_id": {
          "$ref": "#/$defs/relationship_id"
        },
        "kind": {
          "$ref": "#/$defs/relationship_kind"
        },
        "source_entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "target_entity_id": {
          "$ref": "#/$defs/entity_id"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "subject_kind",
        "subject_id",
        "state",
        "derivation"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "subject_kind": {
          "enum": ["entity", "relationship"]
        },
        "subject_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:(?:entity|relationship):blake3:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "candidate",
            "confirmed",
            "derived_fact",
            "deterministic_fact",
            "rejected",
            "reviewed_inference",
            "superseded"
          ]
        },
        "derivation": {
          "oneOf": [
            {
              "$ref": "#/$defs/parser_derivation"
            },
            {
              "$ref": "#/$defs/rule_derivation"
            }
          ]
        }
      }
    },
    "parser_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "extractor_version", "evidence_ids"],
      "properties": {
        "kind": {
          "const": "parser"
        },
        "extractor_version": {
          "const": "codenoesis.rust-tree-sitter/s2-v1"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "rule_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "rule_version",
        "input_claim_ids",
        "evidence_ids"
      ],
      "properties": {
        "kind": {
          "const": "deterministic_rule"
        },
        "rule_version": {
          "const": "codenoesis.rule.rust-file-containment/s2-v1"
        },
        "input_claim_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/claim_id"
          }
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "span"],
      "properties": {
        "code": {
          "enum": [
            "extraction.malformed_syntax",
            "extraction.unsupported_construct",
            "extraction.unresolved_symbol"
          ]
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "span": {
          "$ref": "#/$defs/byte_span"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supported_capabilities", "gaps"],
      "properties": {
        "status": {
          "enum": ["complete", "partial"]
        },
        "supported_capabilities": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 20000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverage_gap"
          }
        }
      }
    },
    "coverage_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "span", "evidence_id"],
      "properties": {
        "code": {
          "enum": [
            "calls_not_extracted",
            "fields_not_extracted",
            "malformed_syntax_excluded",
            "unsupported_construct",
            "unresolved_symbol",
            "variants_not_extracted"
          ]
        },
        "path": {
          "$ref": "#/$defs/canonical_relative_path"
        },
        "span": {
          "$ref": "#/$defs/byte_span"
        },
        "evidence_id": {
          "$ref": "#/$defs/evidence_id"
        }
      }
    },
    "semantic_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "domain", "value"],
      "properties": {
        "algorithm": {
          "const": "blake3-256"
        },
        "domain": {
          "const": "codenoesis.knowledge-graph.semantic.v1"
        },
        "value": {
          "$ref": "#/$defs/blake3"
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_id"
      }
    },
    "entity_kind": {
      "enum": [
        "rust.crate",
        "rust.enum",
        "rust.function",
        "rust.method",
        "rust.module",
        "rust.struct",
        "rust.symbol_reference",
        "rust.trait",
        "rust.type_alias",
        "source.file"
      ]
    },
    "relationship_kind": {
      "enum": ["CONTAINS", "DEFINES", "IMPLEMENTS", "IMPORTS"]
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^urn:codenoesis:[a-z0-9][a-z0-9._:-]{0,254}$"
    },
    "canonical_relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*$"
    },
    "byte_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "start", "end"],
      "properties": {
        "unit": {
          "const": "byte"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^evidence-s2-[0-9]{4}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:entity:blake3:[0-9a-f]{64}$"
    },
    "relationship_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:relationship:blake3:[0-9a-f]{64}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:claim:blake3:[0-9a-f]{64}$"
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
