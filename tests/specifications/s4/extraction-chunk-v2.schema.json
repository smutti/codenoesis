{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/extraction-chunk-v2.schema.json",
  "title": "CodeNoesis ExtractionChunkV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_version",
    "repository_identity",
    "crate_id",
    "source_file_id",
    "semantic_hash",
    "entities",
    "relationships",
    "claims",
    "evidence",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.extraction-chunk/v2"
    },
    "ontology_version": {
      "const": "codenoesis.ontology/rust/v2"
    },
    "repository_identity": {
      "type": "string",
      "minLength": 1
    },
    "crate_id": {
      "$ref": "#/$defs/entity_id"
    },
    "source_file_id": {
      "$ref": "#/$defs/entity_id"
    },
    "semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "blake3-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entity_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:entity:blake3:[0-9a-f]{64}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "crate_id",
        "module_path",
        "name",
        "visibility",
        "properties"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/entity_id"
        },
        "kind": {
          "enum": [
            "rust.crate",
            "source.file",
            "rust.module",
            "rust.struct",
            "rust.enum",
            "rust.trait",
            "rust.type_alias",
            "rust.function",
            "rust.method",
            "rust.symbol_reference"
          ]
        },
        "crate_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/entity_id"
            }
          ]
        },
        "module_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "inherited_trait",
            "not_applicable"
          ]
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:codenoesis:relationship:blake3:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "CONTAINS",
            "DEFINES",
            "IMPORTS",
            "IMPLEMENTS"
          ]
        },
        "source": {
          "$ref": "#/$defs/entity_id"
        },
        "target": {
          "$ref": "#/$defs/entity_id"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:evidence:blake3:[0-9a-f]{64}$"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_kind",
        "subject_id",
        "state",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:codenoesis:claim:blake3:[0-9a-f]{64}$"
        },
        "subject_kind": {
          "enum": [
            "entity",
            "relationship"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "deterministic_fact",
            "derived_fact",
            "candidate",
            "reviewed_inference",
            "confirmed",
            "rejected",
            "superseded"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:evidence:blake3:[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "blob_oid",
        "start_byte",
        "end_byte"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:codenoesis:evidence:blake3:[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "evidence_ids"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "state",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^urn:codenoesis:coverage-gap:blake3:[0-9a-f]{64}$"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "unsupported"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
