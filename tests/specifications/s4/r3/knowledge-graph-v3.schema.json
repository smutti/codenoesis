{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/knowledge-graph-v3.schema.json",
  "title": "CodeNoesis KnowledgeGraphV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_version",
    "repository",
    "extractor_versions",
    "workspace",
    "semantic_hash",
    "entities",
    "relationships",
    "claims",
    "evidence",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.knowledge-graph/v3"
    },
    "ontology_version": {
      "const": "codenoesis.ontology/rust/v3"
    },
    "repository": {
      "$ref": "../../s1/repository-snapshot-v2.schema.json#/$defs/repository"
    },
    "extractor_versions": {
      "const": [
        "codenoesis.rust-tree-sitter/s4-v1",
        "codenoesis.rust-workspace/s4-r3-v1"
      ]
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "semantic_hash": {
      "$ref": "../extraction-chunk-v2.schema.json#/$defs/hash"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/relationship"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/evidence"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/diagnostic"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/coverage"
      }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_shape",
        "members",
        "excluded_paths"
      ],
      "properties": {
        "root_shape": {
          "enum": [
            "standalone_root_package",
            "virtual_workspace",
            "non_virtual_workspace"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 201,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "excluded_paths": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonical_path"
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "manifest_path",
        "member_source",
        "crate_ids",
        "external_boundary_id"
      ],
      "properties": {
        "path": {
          "oneOf": [
            {
              "const": "."
            },
            {
              "$ref": "#/$defs/canonical_path"
            }
          ]
        },
        "manifest_path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/canonical_path"
            }
          ]
        },
        "member_source": {
          "enum": [
            "literal_member",
            "implicit_root_package",
            "explicit_root_member"
          ]
        },
        "crate_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "../extraction-chunk-v2.schema.json#/$defs/entity_id"
          }
        },
        "external_boundary_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^urn:codenoesis:repository-boundary:sha256:[0-9a-f]{64}$"
            }
          ]
        }
      }
    },
    "canonical_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/[^/\\\\\\u0000-\\u001f\\u007f]+)*$"
    }
  }
}
