{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/local-query-result-v1.schema.json",
  "title": "CodeNoesis LocalQueryResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_identity",
    "snapshot_id",
    "requested_id",
    "result_kind",
    "entity",
    "claims",
    "evidence",
    "document",
    "document_statements"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.local-query-result/v1"
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^urn:codenoesis:[a-z0-9][a-z0-9._:-]{0,254}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:snapshot:blake3:[0-9a-f]{64}$"
    },
    "requested_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:(entity|claim|evidence|document):blake3:[0-9a-f]{64}$"
    },
    "result_kind": {
      "enum": [
        "entity",
        "claim",
        "evidence",
        "document"
      ]
    },
    "entity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "extraction-chunk-v2.schema.json#/$defs/entity"
        }
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/evidence"
      }
    },
    "document": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/document"
        }
      ]
    },
    "document_statements": {
      "type": "array",
      "maxItems": 200000,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/statement"
          },
          {
            "$ref": "#/$defs/linked_statement"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result_kind": {
            "const": "entity"
          }
        },
        "required": [
          "result_kind"
        ]
      },
      "then": {
        "properties": {
          "entity": {
            "type": "object"
          },
          "claims": {
            "minItems": 1,
            "maxItems": 1
          },
          "document": {
            "type": "null"
          },
          "document_statements": {
            "items": {
              "$ref": "#/$defs/linked_statement"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_kind": {
            "const": "claim"
          }
        },
        "required": [
          "result_kind"
        ]
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1,
            "maxItems": 1
          },
          "document": {
            "type": "null"
          },
          "document_statements": {
            "items": {
              "$ref": "#/$defs/linked_statement"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_kind": {
            "const": "evidence"
          }
        },
        "required": [
          "result_kind"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "maxItems": 1
          },
          "document": {
            "type": "null"
          },
          "document_statements": {
            "items": {
              "$ref": "#/$defs/linked_statement"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_kind": {
            "const": "document"
          }
        },
        "required": [
          "result_kind"
        ]
      },
      "then": {
        "properties": {
          "entity": {
            "type": "null"
          },
          "claims": {
            "maxItems": 0
          },
          "evidence": {
            "maxItems": 0
          },
          "document": {
            "type": "object"
          },
          "document_statements": {
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/statement"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "kind",
        "subject_id",
        "path",
        "byte_length",
        "blake3"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:document:blake3:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "overview",
            "module"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(overview\\.md|modules/[a-z0-9-]+\\.md)$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "truth_state",
        "subject_ids",
        "evidence_ids",
        "coverage_gap_ids"
      ],
      "properties": {
        "statement_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:statement:blake3:[0-9a-f]{64}$"
        },
        "truth_state": {
          "enum": [
            "deterministic_fact",
            "derived_fact",
            "unsupported"
          ]
        },
        "subject_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:evidence:blake3:[0-9a-f]{64}$"
          }
        },
        "coverage_gap_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:coverage-gap:blake3:[0-9a-f]{64}$"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "truth_state": {
              "enum": [
                "deterministic_fact",
                "derived_fact"
              ]
            },
            "evidence_ids": {
              "minItems": 1
            },
            "coverage_gap_ids": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "truth_state": {
              "const": "unsupported"
            },
            "evidence_ids": {
              "maxItems": 0
            },
            "coverage_gap_ids": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "linked_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "statement_id",
        "truth_state",
        "subject_ids",
        "evidence_ids",
        "coverage_gap_ids"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:document:blake3:[0-9a-f]{64}$"
        },
        "statement_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:statement:blake3:[0-9a-f]{64}$"
        },
        "truth_state": {
          "enum": [
            "deterministic_fact",
            "derived_fact",
            "unsupported"
          ]
        },
        "subject_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:evidence:blake3:[0-9a-f]{64}$"
          }
        },
        "coverage_gap_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:coverage-gap:blake3:[0-9a-f]{64}$"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "truth_state": {
              "enum": [
                "deterministic_fact",
                "derived_fact"
              ]
            },
            "evidence_ids": {
              "minItems": 1
            },
            "coverage_gap_ids": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "truth_state": {
              "const": "unsupported"
            },
            "evidence_ids": {
              "maxItems": 0
            },
            "coverage_gap_ids": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
