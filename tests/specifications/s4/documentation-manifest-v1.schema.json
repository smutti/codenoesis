{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/documentation-manifest-v1.schema.json",
  "title": "CodeNoesis DocumentationManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_identity",
    "snapshot_id",
    "snapshot_semantic_hash",
    "renderer_version",
    "generation_hash",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.documentation-manifest/v1"
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^urn:codenoesis:[a-z0-9][a-z0-9._:-]{0,254}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^urn:codenoesis:snapshot:blake3:[0-9a-f]{64}$"
    },
    "snapshot_semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "renderer_version": {
      "const": "codenoesis.renderer/markdown-v1"
    },
    "generation_hash": {
      "$ref": "#/$defs/hash"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2001,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "blake3-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "kind",
        "subject_id",
        "path",
        "byte_length",
        "blake3",
        "statements"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:document:blake3:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "overview",
            "module"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(overview\\.md|modules/[a-z0-9-]+\\.md)$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/statement"
          }
        }
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_id",
        "truth_state",
        "subject_ids",
        "evidence_ids",
        "coverage_gap_ids"
      ],
      "properties": {
        "statement_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:statement:blake3:[0-9a-f]{64}$"
        },
        "truth_state": {
          "enum": [
            "deterministic_fact",
            "derived_fact",
            "unsupported"
          ]
        },
        "subject_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:evidence:blake3:[0-9a-f]{64}$"
          }
        },
        "coverage_gap_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^urn:codenoesis:coverage-gap:blake3:[0-9a-f]{64}$"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "truth_state": {
              "enum": [
                "deterministic_fact",
                "derived_fact"
              ]
            },
            "evidence_ids": {
              "minItems": 1
            },
            "coverage_gap_ids": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "truth_state": {
              "const": "unsupported"
            },
            "evidence_ids": {
              "maxItems": 0
            },
            "coverage_gap_ids": {
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
