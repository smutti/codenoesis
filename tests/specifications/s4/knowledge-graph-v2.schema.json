{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/knowledge-graph-v2.schema.json",
  "title": "CodeNoesis KnowledgeGraphV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_version",
    "repository",
    "extractor_versions",
    "semantic_hash",
    "entities",
    "relationships",
    "claims",
    "evidence",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.knowledge-graph/v2"
    },
    "ontology_version": {
      "const": "codenoesis.ontology/rust/v2"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "commit_oid"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "commit_oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "extractor_versions": {
      "const": [
        "codenoesis.rust-tree-sitter/s4-v1",
        "codenoesis.rust-workspace/s4-v1"
      ]
    },
    "semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/relationship"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/evidence"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/diagnostic"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "extraction-chunk-v2.schema.json#/$defs/coverage"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "blake3-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
