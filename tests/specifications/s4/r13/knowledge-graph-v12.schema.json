{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schema/knowledge-graph-v12.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_version",
    "extractor_versions",
    "repository",
    "workspace",
    "manifest_index",
    "rust_semantic_index",
    "framework_declaration_index",
    "callable_semantics_index",
    "compiler_index",
    "callable_compiler_join_index",
    "entities",
    "relationships",
    "claims",
    "evidence",
    "diagnostics",
    "coverage",
    "semantic_hash"
  ],
  "properties": {
    "schema_version": {"const": "codenoesis.knowledge-graph/v12"},
    "ontology_version": {"const": "codenoesis.ontology/rust/v12"},
    "extractor_versions": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "codenoesis.rust-framework/s4-r6-v1"}},
        {"contains": {"const": "codenoesis.scip-import/s4-r7-v1"}},
        {"contains": {"const": "codenoesis.rust-callable/s4-k1-v1"}},
        {"contains": {"const": "codenoesis.rust-callable-scip-composition/s4-r13-v1"}}
      ]
    },
    "repository": {"type": "object"},
    "workspace": {"type": "object"},
    "manifest_index": {"type": "object"},
    "rust_semantic_index": {"type": "object"},
    "framework_declaration_index": {"type": "object"},
    "callable_semantics_index": {"type": "object"},
    "compiler_index": {"type": "object"},
    "callable_compiler_join_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "relationship_kind", "joins"],
      "properties": {
        "schema_version": {"const": "codenoesis.callable-compiler-join-index/v1"},
        "relationship_kind": {"const": "HAS_COMPILER_SYMBOL"},
        "joins": {
          "type": "array",
          "maxItems": 200000,
          "items": {"$ref": "#/$defs/join"}
        }
      }
    },
    "entities": {"$ref": "#/$defs/family"},
    "relationships": {"$ref": "#/$defs/family"},
    "claims": {"$ref": "#/$defs/family"},
    "evidence": {"$ref": "#/$defs/family"},
    "diagnostics": {"$ref": "#/$defs/family"},
    "coverage": {"$ref": "#/$defs/family"},
    "semantic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "family": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}},
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_callable_id", "signature_id", "compiler_symbol_id", "relationship_id"],
      "properties": {
        "source_callable_id": {"type": "string", "pattern": "^urn:codenoesis:entity:blake3:[0-9a-f]{64}$"},
        "signature_id": {"type": "string", "pattern": "^urn:codenoesis:entity:blake3:[0-9a-f]{64}$"},
        "compiler_symbol_id": {"type": "string", "pattern": "^urn:codenoesis:entity:blake3:[0-9a-f]{64}$"},
        "relationship_id": {"type": "string", "pattern": "^urn:codenoesis:relationship:blake3:[0-9a-f]{64}$"}
      }
    },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "blake3-256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

