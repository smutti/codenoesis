{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schema/codenoesis-error-v18.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "code", "stage", "message", "retryable", "context"],
  "properties": {
    "schema_version": {"const": "codenoesis.error/v18"},
    "code": {
      "enum": [
        "input.invalid_rust_callable_profile",
        "input.unsupported_rust_callable_composition",
        "input.invalid_repository_boundary_profile",
        "input.invalid_repository_boundary_manifest",
        "input.unsafe_output_path",
        "acquisition.repository_boundary_metadata_invalid",
        "acquisition.nested_repository_mismatch",
        "acquisition.nested_repository_unavailable",
        "acquisition.nested_repository_changed",
        "acquisition.repository_boundary_limit_exceeded",
        "acquisition.limit_exceeded",
        "extraction.rust_semantic_identity_conflict",
        "extraction.invalid_callable_syntax",
        "extraction.callable_identity_conflict",
        "extraction.callable_limit_exceeded",
        "snapshot.invalid_v13",
        "query.invalid_v13",
        "export.invalid_snapshot",
        "export.invalid_portable_graph_v4",
        "export.limit_exceeded",
        "explorer.asset_integrity_mismatch",
        "explorer.limit_exceeded",
        "internal.unexpected"
      ]
    },
    "stage": {"enum": ["input", "acquisition", "extraction", "snapshot", "query", "export", "explorer", "internal"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 256},
    "retryable": {"type": "boolean"},
    "context": {"type": "object"}
  }
}
