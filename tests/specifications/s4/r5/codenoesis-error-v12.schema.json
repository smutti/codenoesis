{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/codenoesis-error-v12.schema.json",
  "title": "CodeNoesisErrorV12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "stage",
    "message",
    "retryable",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.error/v12"
    },
    "code": {
      "enum": [
        "input.invalid_rust_semantic_profile",
        "extraction.invalid_rust_semantic_declaration",
        "extraction.rust_semantic_identity_conflict",
        "extraction.rust_semantic_limit_exceeded",
        "extraction.unsupported_rust_semantic_composition",
        "internal.unexpected"
      ]
    },
    "stage": {
      "enum": [
        "input",
        "extraction",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "retryable": {
      "const": false
    },
    "context": {
      "oneOf": [
        {
          "$ref": "#/$defs/profile_context"
        },
        {
          "$ref": "#/$defs/declaration_context"
        },
        {
          "$ref": "#/$defs/identity_context"
        },
        {
          "$ref": "#/$defs/limit_context"
        },
        {
          "$ref": "#/$defs/composition_context"
        },
        {
          "$ref": "#/$defs/empty_context"
        }
      ]
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "profile_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provided_profile"
      ],
      "properties": {
        "provided_profile": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "declaration_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_byte",
        "declaration_kind"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "start_byte": {
          "type": "integer",
          "minimum": 0
        },
        "declaration_kind": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "identity_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "member_kind",
        "normalized_member"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "pattern": "^urn:codenoesis:entity:blake3:[0-9a-f]{64}$"
        },
        "member_kind": {
          "type": "string",
          "maxLength": 128
        },
        "normalized_member": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "limit_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "maximum",
        "observed"
      ],
      "properties": {
        "limit": {
          "enum": [
            "fields_per_owner",
            "variants_per_enum",
            "tuple_fields_per_owner",
            "associated_items_per_context",
            "outer_attributes_per_declaration",
            "attribute_token_bytes",
            "declared_type_or_header_bytes"
          ]
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "composition_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "required_profile",
        "reason"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "maxLength": 256
        },
        "required_profile": {
          "type": "string",
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "empty_context": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "input.invalid_rust_semantic_profile"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "input"
          },
          "context": {
            "$ref": "#/$defs/profile_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "extraction.invalid_rust_semantic_declaration"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "extraction"
          },
          "context": {
            "$ref": "#/$defs/declaration_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "extraction.rust_semantic_identity_conflict"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "extraction"
          },
          "context": {
            "$ref": "#/$defs/identity_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "extraction.rust_semantic_limit_exceeded"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "extraction"
          },
          "context": {
            "$ref": "#/$defs/limit_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "extraction.unsupported_rust_semantic_composition"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "extraction"
          },
          "context": {
            "$ref": "#/$defs/composition_context"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "internal.unexpected"
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "stage": {
            "const": "internal"
          },
          "context": {
            "$ref": "#/$defs/empty_context"
          }
        }
      }
    }
  ]
}
