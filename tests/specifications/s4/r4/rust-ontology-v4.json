  "claim_policy": {
    "literal_declaration_entities": "deterministic_fact",
    "declaration_reference_relationships": "deterministic_fact",
    "target_materialization_relationships": "derived_fact",
    "conventional_or_absent_build_script": "derived_fact",
    "forbidden_states_for_cargo_subjects": [
      "candidate",
      "reviewed_inference",
      "confirmed",
      "rejected",
      "superseded"
    ]
  },
  "evidence_policy": {
    "required_for_every_cargo_entity": true,
    "required_for_every_cargo_relationship": true,
    "required_for_every_metadata_value": true,
    "required_for_every_requested_feature": true,
    "required_for_every_feature_member": true,
    "span_unit": "UTF-8 byte offset in the committed manifest blob",
    "locator_projection": "sha256 digest plus evidence span; plaintext is forbidden outside the bound source blob"
  },
  "coverage_capability_states": {
    "cargo.active_features_not_resolved": "not_resolved",
    "cargo.active_target_not_resolved": "not_resolved",
    "cargo.build_script_not_executed": "not_executed",
    "cargo.dependency_advanced_fields_unsupported": "unsupported",
    "cargo.dependency_graph_not_resolved": "not_resolved",
    "cargo.dependency_source_not_fetched": "not_fetched",
    "cargo.external_locator_redacted": "redacted",
    "cargo.generated_source_not_analyzed": "not_analyzed",
    "cargo.lint_configuration_unsupported": "unsupported",
    "cargo.package_file_selection_not_applied": "not_applied",
    "cargo.package_metadata_table_unsupported": "unsupported",
    "cargo.patch_not_applied": "not_applied",
    "cargo.proc_macro_not_executed": "not_executed",
    "cargo.profile_tables_unsupported": "unsupported",
    "cargo.replace_table_unsupported": "unsupported",
    "cargo.target_source_not_analyzed": "not_analyzed",
    "cargo.workspace_inheritance_not_materialized": "not_resolved"
  },
  "cardinality": {
    "manifest_entity": "exactly one cargo.manifest per analyzed Cargo.toml",
    "package_entity": "zero or one cargo.package per analyzed manifest",
    "declaration_owner": "every non-manifest Cargo entity has exactly one incoming DECLARES",
    "workspace_reference": "an inherited package or dependency declaration has exactly one REFERENCES_DECLARATION target",
    "target_materialization": "an R3-analyzed lib or bin declaration has exactly one MATERIALIZES edge; other declared targets have none",
    "claim_subject": "every Cargo entity and Cargo relationship has exactly one claim",
    "evidence_resolution": "every Cargo fact and relationship resolves to committed manifest or inventory evidence"
  },
  "limits": {
    "manifest_fact_entities": 10000,
    "dependencies_per_manifest": 256,
    "features_per_manifest": 256,
    "feature_members_per_feature": 128,
    "targets_per_package": 128,
    "patches_per_workspace": 256,
    "metadata_fields_per_owner": 32,
    "requested_features_per_declaration": 64,
    "target_predicates_per_manifest": 128,
    "declaration_string_bytes": 2048,
    "external_locator_bytes": 4096,
    "permutations": 50
