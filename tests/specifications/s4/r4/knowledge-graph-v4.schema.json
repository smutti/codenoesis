{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/knowledge-graph-v4.schema.json",
  "title": "CodeNoesis KnowledgeGraphV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ontology_version",
    "repository",
    "extractor_versions",
    "workspace",
    "manifest_index",
    "semantic_hash",
    "entities",
    "relationships",
    "claims",
    "evidence",
    "diagnostics",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "codenoesis.knowledge-graph/v4"
    },
    "ontology_version": {
      "const": "codenoesis.ontology/rust/v4"
    },
    "repository": {
      "$ref": "../../s1/repository-snapshot-v2.schema.json#/$defs/repository"
    },
    "extractor_versions": {
      "const": [
        "codenoesis.rust-tree-sitter/s4-v1",
        "codenoesis.rust-workspace/s4-r3-v1",
        "codenoesis.cargo-manifest/s4-r4-v1"
      ]
    },
    "workspace": {
      "$ref": "../r3/knowledge-graph-v3.schema.json#/$defs/workspace"
    },
    "manifest_index": {
      "$ref": "#/$defs/manifest_index"
    },
    "semantic_hash": {
      "$ref": "../extraction-chunk-v2.schema.json#/$defs/hash"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30000,
      "items": {
        "$ref": "extraction-chunk-v4.schema.json#/$defs/graph_entity"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 60000,
      "items": {
        "$ref": "extraction-chunk-v4.schema.json#/$defs/graph_relationship"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 90000,
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 90000,
      "items": {
        "$ref": "../extraction-chunk-v2.schema.json#/$defs/evidence"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "extraction-chunk-v4.schema.json#/$defs/diagnostic"
      }
    },
    "coverage": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "extraction-chunk-v4.schema.json#/$defs/coverage"
      }
    }
  },
  "$defs": {
    "manifest_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "manifests"
      ],
      "properties": {
        "schema_version": {
          "const": "codenoesis.cargo-manifest-index/v1"
        },
        "manifests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/manifest_entry"
          }
        }
      }
    },
    "manifest_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "manifest_path",
        "package_id",
        "fact_entity_ids"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "extraction-chunk-v4.schema.json#/$defs/entity_id"
        },
        "manifest_path": {
          "$ref": "extraction-chunk-v4.schema.json#/$defs/canonical_path"
        },
        "package_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "extraction-chunk-v4.schema.json#/$defs/entity_id"
            }
          ]
        },
        "fact_entity_ids": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "$ref": "extraction-chunk-v4.schema.json#/$defs/entity_id"
          }
        }
      }
    }
  }
}
