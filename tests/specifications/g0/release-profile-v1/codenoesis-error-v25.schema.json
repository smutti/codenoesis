{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/codenoesis-error-v25.schema.json",
  "title": "CodeNoesisErrorV25",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "stage",
    "message",
    "retryable",
    "context"
  ],
  "properties": {
    "schema_version": { "const": "codenoesis.error/v25" },
    "code": {
      "enum": [
        "input.invalid_profile_command",
        "input.invalid_format",
        "profile.unknown",
        "profile.unsupported_platform",
        "profile.contract_invalid"
      ]
    },
    "stage": { "enum": ["input", "profile", "internal"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 128 },
    "retryable": { "const": false },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 2,
      "properties": {
        "profile_id": { "type": "string", "maxLength": 128 },
        "target": { "type": "string", "maxLength": 128 }
      }
    }
  }
}
