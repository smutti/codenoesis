{
  "schema_version": "codenoesis.federation-rule-catalog/v1",
  "catalog_version": "codenoesis.federation-rules/http-json/v1",
  "analysis_profile": "standard-local-s6",
  "contract_capability": "codenoesis.contract-capability/openapi-3.1-http-json/v1",
  "authority_order": [
    "explicit_workspace_identity",
    "package_or_scip_identity",
    "canonical_operation_identity",
    "event_or_schema_identity",
    "heuristic_candidate"
  ],
  "capabilities": [
    {
      "authority": "explicit_workspace_identity",
      "status": "supported",
      "confirmation": "deterministic"
    },
    {
      "authority": "package_or_scip_identity",
      "status": "not_exposed",
      "confirmation": "coverage_gap"
    },
    {
      "authority": "canonical_operation_identity",
      "status": "supported",
      "confirmation": "deterministic"
    },
    {
      "authority": "event_or_schema_identity",
      "status": "not_exposed",
      "confirmation": "coverage_gap"
    },
    {
      "authority": "heuristic_candidate",
      "status": "supported",
      "confirmation": "never_automatic"
    }
  ],
  "states": [
    "candidate",
    "confirmed",
    "rejected",
    "unresolved"
  ],
  "rules": [
    {
      "id": "fed.explicit-operation.confirm/v1",
      "precedence": 10,
      "requires": [
        "explicit_workspace_identity",
        "canonical_service_identity",
        "canonical_operation_identity",
        "exact_revision_binding"
      ],
      "outcome": "confirmed",
      "on_conflict": "unresolved"
    },
    {
      "id": "fed.operation-identity.confirm/v1",
      "precedence": 20,
      "requires": [
        "canonical_service_identity",
        "canonical_operation_identity",
        "exact_revision_binding"
      ],
      "outcome": "confirmed",
      "on_conflict": "unresolved"
    },
    {
      "id": "fed.operation-decoy.reject/v1",
      "precedence": 30,
      "requires": [
        "canonical_operation_identity",
        "provider_operation_absent"
      ],
      "outcome": "rejected",
      "on_conflict": "unresolved"
    },
    {
      "id": "fed.heuristic-name.candidate/v1",
      "precedence": 40,
      "requires": [
        "bounded_name_similarity"
      ],
      "outcome": "candidate",
      "on_conflict": "unresolved"
    },
    {
      "id": "fed.conflict.unresolved/v1",
      "precedence": 50,
      "requires": [
        "conflicting_authoritative_evidence"
      ],
      "outcome": "unresolved",
      "on_conflict": "unresolved"
    }
  ],
  "failure_precedence": [
    "invocation",
    "workspace_manifest",
    "repository_binding",
    "contract_encoding",
    "yaml_structure",
    "openapi_profile",
    "local_reference",
    "client_declaration",
    "federation_identity",
    "resource_limit",
    "report_validation",
    "internal"
  ],
  "limits": {
    "workspace_manifest_bytes": 8388608,
    "repositories": 128,
    "contract_documents": 256,
    "contract_bytes_per_document": 2097152,
    "yaml_nesting_depth": 32,
    "local_ref_depth": 16,
    "path_items": 10000,
    "operations": 10000,
    "schemas": 20000,
    "fields_per_operation": 5000,
    "clients": 10000,
    "declarations": 100000,
    "confirmed_links": 1000000,
    "candidates": 200000,
    "rejections": 200000,
    "evidence_items": 1000000,
    "coverage_gaps": 200000,
    "report_bytes": 67108864,
    "memory_bytes": 536870912,
    "wall_milliseconds": 60000
  }
}
