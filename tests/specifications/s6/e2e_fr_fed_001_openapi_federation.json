  "determinism": {
    "canonicalization": "RFC 8785 JSON with LF termination",
    "collection_order": "ascending stable identity unless a documented precedence list applies",
    "semantic_hash_projection": "remove semantic_hash, all evidence objects and evidence_ids, provider source path/hash/format, and client declaration paths; prefix canonical projection with codenoesis.federation-report.semantic.v1 plus NUL",
    "replays": 50,
    "parallel_repetitions": 10,
    "retry_policy": "a retry is diagnostic and never converts the original failure into evidence"
  },
  "security": {
    "allowed_reads": "workspace manifest plus explicitly bound local provider and client roots",
    "writes": "none",
    "target_processes": 0,
    "network_channels": 0,
    "plugins": 0,
    "model_providers": 0,
    "remote_refs": "forbidden before any fetch attempt",
    "yaml_aliases_tags_merges": "rejected from marked parser events before normalized model construction",
    "first_party_unsafe": 0,
    "all_or_nothing": "no stdout bytes before the complete report passes identities, references, limits, schema, canonicalization, and semantic hash"
  },
  "compatibility": {
    "unchanged_profiles": [
      "legacy-s0",
      "standard-local-s1",
      "standard-local-s2",
      "standard-local-s3",
      "standard-local-s4",
      "standard-local-s5"
    ],
    "persistent_store_change": false,
    "ontology_change": false,
    "existing_artifact_change": false,
    "downstream_s7": "service, operation, field, decoy, safe-client, and strict-client identities must equal the immutable S7 fixture; S6 does not prove S7 source behavior"
  },
  "expected_red": {
    "test_target": "e2e_fr_fed_001_openapi_federation",
    "command": "cargo test --locked -p noesis --test e2e_fr_fed_001_openapi_federation -- --exact e2e_fr_fed_001_openapi_federation",
    "base_behavior_probe": "target/debug/noesis federate --workspace-manifest /nonexistent --profile standard-local-s6 --format json",
    "runner_exit": "nonzero",
    "subject_exit": 2,
    "stdout_bytes": 0,
    "stderr_schema": "codenoesis.error/v2",
    "stderr_code": "input.invalid_revision",
    "stderr_sha256": "6441e0037f864d2fae4a60e6355e4a85b26b00d5e4e24c59ffeb5fe9c6f3859f",
    "stderr_bytes": 149,
    "store_or_artifact_created": false,
    "accepted_reason": "the merged pre-S6 binary has no federate command and returns the exact existing invocation-boundary error before any S6 production edit",
    "rejected_reasons": [
      "compilation failure",
      "dependency or network outage",
      "missing fixture or test target",
      "modified oracle",
      "panic",
      "schema-invalid harness",
      "target execution",
      "timeout",
      "validation of hand-authored JSON without the public command"
    ]
  },
  "allowed_paths": [
    "docs/software/software-requirements-specification.md",
    "docs/software/decisions/0009-s6-openapi-federation-contract.md",
    "tests/specifications/s6",
    "tests/fixtures/s6/openapi-federation-v1",
    "scripts/tests/test_s6_openapi_federation_contract.py"
  ],
  "forbidden": [
    "production Rust code",
    "dependency manifests or lockfiles",
    "workflow, policy, agent, architecture, or roadmap files",
    "ontology, schema migration, or persistent storage changes",
    "existing accepted S0 through S5 or S7 protected artifact bytes",
    "target, Git, compiler, package-manager, build-script, hook, plugin, network, model, or Council execution",
    "remote reference resolution",
    "automatic heuristic confirmation",
    "partial stdout or persistent publication",
    "automatic golden or oracle refresh"
  ],
  "required_implementation_evidence": [
    "retained expected Red before production edits",
    "exact success and error goldens",
    "schema, identity, reference, ordering, and semantic-hash mutation rejection",
    "every boundary maximum and maximum-plus-one",
    "YAML and JSON normalized differential equivalence",
    "malformed and fuzz corpus",
    "dependency license, advisory, transitive unsafe, and checksum inventory",
    "50 deterministic replays and 10 shuffled parallel repetitions",
    "process, network, write, outside-root, descriptor, sentinel, memory, CPU, and wall observers",
    "all S0 through S5 regressions",
    "full repository gate and exact-head immutable CI"
  ],
  "stop_conditions": [
    "a second YAML or OpenAPI parser dependency is required",
    "an existing protected contract, fixture, schema, ontology, storage format, workflow, policy, or architecture byte must change",
    "a remote reference or target execution becomes necessary",
    "an authority conflict cannot remain typed and unresolved",
    "a heuristic must be promoted automatically to pass",
    "a fixed maximum cannot produce its exact typed maximum-plus-one result",
    "the expected Red is not observed for the approved reason",
    "the same deterministic failure recurs after the authorized correction budget",
    "a gate can pass only by weakening the oracle"
  ]
