{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/local-upgrade-plan-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["activation", "automatic_update", "candidate", "compatibility", "configuration_transition", "current", "downgrade", "platform_target", "profile_id", "publication", "release_status", "rollback", "schema_version", "signing", "support", "verification"],
  "properties": {
    "activation": {"const": "caller-owned"},
    "automatic_update": {"const": false},
    "candidate": {"$ref": "#/$defs/bundle"},
    "compatibility": {"const": "exact-g1a-side-by-side"},
    "configuration_transition": {"const": "identical-v1-no-migration"},
    "current": {"$ref": "#/$defs/bundle"},
    "downgrade": {"const": "forbidden-without-exact-plan"},
    "platform_target": {"enum": ["aarch64-apple-darwin", "x86_64-pc-windows-msvc", "x86_64-unknown-linux-gnu"]},
    "profile_id": {"const": "local-experimental-r17"},
    "publication": {"const": false},
    "release_status": {"const": "not-ga"},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required_current_manifest_sha256", "target_manifest_sha256"],
      "properties": {
        "mode": {"const": "exact-prior-bundle"},
        "required_current_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "target_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "schema_version": {"const": "codenoesis.local-upgrade-plan/v1"},
    "signing": {"const": "not-available"},
    "support": {"const": "none"},
    "verification": {"const": "not-verified"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary_sha256", "bundle_name", "manifest_sha256"],
      "properties": {
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "bundle_name": {"type": "string", "pattern": "^codenoesis-local-experimental-r17-[A-Za-z0-9_-]+-[0-9a-f]{64}$", "maxLength": 192},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
