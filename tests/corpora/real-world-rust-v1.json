    "ordered_steps": [
      {
        "id": "fresh_clone",
        "commands": [
          [
            "git",
            "clone",
            "--no-checkout",
            "{repository_url}",
            "{repository_root}"
          ]
        ],
        "purpose": "Create a normal non-shallow full clone in a fresh temporary root; network use ends when this step completes."
      },
      {
        "id": "verify_commit",
        "commands": [
          [
            "git",
            "-C",
            "{repository_root}",
            "rev-parse",
            "--verify",
            "{pinned_commit}^{commit}"
          ]
        ],
        "purpose": "Bind the observed revision to the exact pinned commit."
      },
      {
        "id": "verify_tree",
        "commands": [
          [
            "git",
            "-C",
            "{repository_root}",
            "rev-parse",
            "--verify",
            "{pinned_commit}^{tree}"
          ]
        ],
        "purpose": "Bind immutable tree statistics to the exact commit tree."
      },
      {
        "id": "tree_statistics",
        "commands": [
          [
            "git",
            "-C",
            "{repository_root}",
            "ls-tree",
            "-r",
            "-t",
            "-z",
            "-l",
            "{pinned_commit}^{tree}"
          ]
        ],
        "purpose": "Parse NUL-delimited records by mode, kind, OID, declared blob size, and path; derive all immutable_tree counters without checkout."
      },
      {
        "id": "pack_headers_and_sizes",
        "commands": [
          [
            "wc",
            "-c",
            "{pack_path}",
            "{index_path}"
          ],
          [
            "od",
            "-An",
            "-tx1",
            "-N12",
            "{pack_path}"
          ],
          [
            "od",
            "-An",
            "-tx1",
            "-N8",
            "{index_path}"
          ]
        ],
        "purpose": "Record physical byte lengths plus pack and index signatures, versions, and pack object count."
      },
      {
        "id": "verify_pack",
        "commands": [
          [
            "git",
            "-C",
            "{pack_directory}",
            "verify-pack",
            "-v",
            "{index_basename}"
          ]
        ],
        "purpose": "Derive indexed object count, delta object count, and maximum delta-chain depth from the complete contextual clone pack."
      },
      {
        "id": "packed_baseline",
        "commands": [
          [
            "noesis",
            "scan",
            "--repository",
            "{repository_root}",
            "--repository-id",
            "{repository_id}",
            "--revision",
            "{pinned_commit}",
            "--profile",
            "standard-local-s4",
            "--store",
            "{store_root}",
            "--format",
            "json"
          ]
        ],
        "purpose": "Capture exit status, stdout byte count, and the canonical typed stderr line on the normal packed clone."
      },
      {
        "id": "materialize_loose_control",
        "commands": [
          [
            "sh",
            "-ceu",
            "repo=$1; pack=$2; index=$3; archive=$4; commit=$5; unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CONFIG_COUNT; export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null; pack_dir=$repo/.git/objects/pack; test -f \"$pack\"; test -f \"$index\"; test \"$(find \"$pack_dir\" -type f -name '*.pack' -print | awk 'END {print NR + 0}')\" -eq 1; test \"$(find \"$pack_dir\" -type f -name '*.idx' -print | awk 'END {print NR + 0}')\" -eq 1; test ! -e \"$archive\"; mkdir -p \"$archive\"; base=${pack%.pack}; test ! -e \"$base.promisor\"; for sidecar in \"$base.pack\" \"$base.idx\" \"$base.rev\" \"$base.bitmap\" \"$base.mtimes\" \"$base.keep\"; do if test -f \"$sidecar\"; then mv \"$sidecar\" \"$archive\"/; fi; done; test \"$(find \"$pack_dir\" -type f \\( -name '*.pack' -o -name '*.idx' \\) -print | awk 'END {print NR + 0}')\" -eq 0; git -C \"$repo\" unpack-objects < \"$archive/$(basename \"$pack\")\"; test ! -e \"$repo/.git/objects/info/alternates\"; counts=$(git -C \"$repo\" count-objects -v); loose_objects=$(printf '%s\\n' \"$counts\" | awk '$1 == \"count:\" {print $2}'); in_pack=$(printf '%s\\n' \"$counts\" | awk '$1 == \"in-pack:\" {print $2}'); packs=$(printf '%s\\n' \"$counts\" | awk '$1 == \"packs:\" {print $2}'); test \"$loose_objects\" -gt 0; test \"$in_pack\" -eq 0; test \"$packs\" -eq 0; git -C \"$repo\" fsck --full --no-reflogs \"$commit\" >/dev/null 2>&1; actual_commit=$(git -C \"$repo\" rev-parse --verify \"$commit^{commit}\"); tree=$(git -C \"$repo\" rev-parse --verify \"$commit^{tree}\"); printf '{\"commit\":\"%s\",\"loose_objects\":%s,\"procedure_version\":\"codenoesis.public-corpus-observation/v1\",\"tree\":\"%s\"}\\n' \"$actual_commit\" \"$loose_objects\" \"$tree\"",
            "codenoesis-loose-v1",
            "{repository_root}",
            "{pack_path}",
            "{index_path}",
            "{pack_archive_root}",
            "{pinned_commit}"
          ]
        ],
        "purpose": "Execute the exact fail-fast shell argv outside the monitored subject: sanitize Git authority, require one observed pair, archive all authoritative sidecars, prove zero remaining packs and alternates, unpack and fsck loose OIDs, then emit one canonical replay-output line."
      },
      {
        "id": "loose_baseline",
        "commands": [
          [
            "noesis",
            "scan",
            "--repository",
            "{repository_root}",
            "--repository-id",
            "{repository_id}",
            "--revision",
            "{pinned_commit}",
            "--profile",
            "standard-local-s4",
            "--store",
            "{store_root}",
            "--format",
            "json"
          ]
        ],
        "purpose": "Repeat the exact baseline command against the verified loose-only control and capture the next generic blocker."
      }
    ],
    "normalization": "entry normalized_log binds descriptor fields and retained raw command-output digests in fixed key order and is SHA-256 hashed as one canonical JSON line"
