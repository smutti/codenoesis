{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex pull-request review",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "limitations"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "needs_changes", "human_review"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "confidence",
          "title",
          "file",
          "line",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "recommendation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
