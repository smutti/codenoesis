{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codenoesis.dev/schemas/benchmark-manifest-v1.json",
  "title": "CodeNoesis benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "status",
    "requirements",
    "report_required_fields",
    "suites"
  ],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "scaffold",
        "active"
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^NFR-PER-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "report_required_fields": {
      "type": "array",
      "items": {
        "enum": [
          "cache_state",
          "concurrency",
          "corpus_version",
          "enabled_extractors",
          "host",
          "percentile_method",
          "repetitions",
          "success_rate"
        ]
      },
      "minItems": 8,
      "uniqueItems": true
    },
    "suites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suite"
      }
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_state",
        "concurrency",
        "corpus",
        "description",
        "enabled_extractors",
        "host_profile",
        "id",
        "metrics",
        "minimum_success_rate",
        "percentile_method",
        "repetitions",
        "runner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "host_profile": {
          "type": "string",
          "minLength": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "cache_state": {
          "enum": [
            "cold",
            "warm",
            "mixed"
          ]
        },
        "enabled_extractors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "repetitions": {
          "type": "integer",
          "minimum": 3
        },
        "percentile_method": {
          "type": "string",
          "minLength": 1
        },
        "minimum_success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "runner": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
